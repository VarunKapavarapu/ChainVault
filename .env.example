# ===========================================
# ChainVault — Environment Configuration
# ===========================================

# Blockchain Network
HARDHAT_NETWORK=localhost
RPC_URL=http://127.0.0.1:8545

# Contract Addresses (populated after deployment)
IDENTITY_CONTRACT_ADDRESS=
ACCESS_CONTROL_CONTRACT_ADDRESS=
ASSET_NFT_CONTRACT_ADDRESS=
AUDIT_LOGGER_CONTRACT_ADDRESS=

# Frontend
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_ID=31337
VITE_IDENTITY_CONTRACT_ADDRESS=
VITE_ACCESS_CONTROL_CONTRACT_ADDRESS=
VITE_ASSET_NFT_CONTRACT_ADDRESS=
VITE_AUDIT_LOGGER_CONTRACT_ADDRESS=

# Demo Mode (set to true if no blockchain available)
VITE_DEMO_MODE=false

# Backend (if used)
PORT=3001
MONGODB_URI=mongodb://localhost:27017/chainvault

# NEVER commit actual private keys
# DEPLOYER_PRIVATE_KEY=
